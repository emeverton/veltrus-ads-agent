          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.VELTRUS_API_KEY }}"
            }
          ]
        },
        "options": {}
      },
      "id": "http-get-lead",
      "name": "GET Lead by CRM Deal ID",
