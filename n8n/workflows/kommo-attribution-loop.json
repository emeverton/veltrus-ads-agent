              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=minimal"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"lead_id\": \"{{ $('GET Lead by CRM Deal ID').item.json.id }}\",\n  \"campaign_id\": \"{{ $('GET Lead by CRM Deal ID').item.json.campaign_id }}\",\n  \"client_id\": \"{{ $('GET Lead by CRM Deal ID').item.json.client_id }}\",\n  \"crm_deal_id\": \"{{ $('Webhook').item.json.body.deal_id || $('Webhook').item.json.deal_id }}\",\n  \"revenue_amount\": {{ $('Webhook').item.json.body.deal_value || $('Webhook').item.json.deal_value || 0 }},\n  \"closed_at\": \"{{ $now.toISO() }}\"\n}",
        "options": {}
      },
      "id": "http-insert-deal",
      "name": "INSERT Deal (Supabase)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [960, 220]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"status\": \"ok\" }",
        "options": {
          "responseCode": 200
        }
      },
      "id": "respond-ok",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1200, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"status\": \"ok\", \"note\": \"lead not found\" }",
        "options": {
          "responseCode": 200
        }
      },
      "id": "respond-ok-no-lead",
      "name": "Respond (No Lead)",
