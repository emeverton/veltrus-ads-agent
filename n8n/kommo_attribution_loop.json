        "specifyBody": "json",
        "jsonBody": "={\n  \"lead_id\": \"{{ $('GET Lead by CRM Deal ID').item.json.id }}\",\n  \"campaign_id\": \"{{ $('GET Lead by CRM Deal ID').item.json.campaign_id }}\",\n  \"client_id\": \"{{ $('GET Lead by CRM Deal ID').item.json.client_id }}\",\n  \"crm_deal_id\": \"{{ $('Webhook').item.json.body.deal_id }}\",\n  \"revenue_amount\": {{ $('Webhook').item.json.body.deal_value }},\n  \"closed_at\": \"{{ $now.toISO() }}\"\n}",
        "options": {}
      },
      "id": "node-insert-deal",
      "name": "INSERT Deal in Supabase",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
