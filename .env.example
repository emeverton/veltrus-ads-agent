# =============================================================================
# VELTRUS ADS AGENT — Variáveis de Ambiente
# Copie este arquivo para .env e preencha todos os valores
# =============================================================================

# -----------------------------------------------------------------------------
# ANTHROPIC (LLM)
# https://console.anthropic.com/
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# Modelo padrão do agente
ANTHROPIC_MODEL=claude-sonnet-4-6

# -----------------------------------------------------------------------------
# SUPABASE
# https://supabase.com/dashboard/project/<project-id>/settings/api
# -----------------------------------------------------------------------------
SUPABASE_URL=https://<project-id>.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

#-----------------------------------------------------------------------------
# META ADS (Facebook / Instagram)
# https://developers.facebook.com/apps/
# -----------------------------------------------------------------------------
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_

# Versão da API (ex: v21.0)
META_API_VERSION=v21.0

# -----------------------------------------------------------------------------
# GOOGLE ADS
# https://developers.google.com/google-ads/api/docs/first-call/overview
# -----------------------------------------------------------------------------
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=

# Login Customer ID (MCC account, se aplicável)
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# -----------------------------------------------------------------------------
# FASTAPI / SERVIDOR
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=gere-uma-chave-secreta-forte-aqui
API_ALLOWED_ORIGINS=http://localhost:3000

# Ambiente: development | staging | production
ENVIRONMENT=development
DEBUG=true

# -----------------------------------------------------------------------------
# NEXT.JS DASHBOARD
# Prefixo NEXT_PUBLIC_ torna a variável acessível no browser
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://<project-id>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# -----------------------------------------------------------------------------
# REDIS (fila de tarefas Celery — opcional em dev)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# AGENTE — Configurações de comportamento
# -----------------------------------------------------------------------------
# Intervalo de ciclo do agente em minutos
AGENT_CYCLE_INTERVAL_MINUTES=30

# Limite de gasto diário por conta de anúncio (USD) — fallback legado
AGENT_MAX_DAILY_SPEND_USD=500

# Guardrails em BRL (enforcement programático — agent/guardrails.py)
AGENT_MAX_DAILY_SPEND_BRL=200
AGENT_MAX_CPA_BRL=100
AGENT_MIN_ROAS=2.0
AGENT_USD_BRL_RATE=5.0

# Percentual máximo de ajuste de orçamento por ciclo
AGENT_MAX_BUDGET_CHANGE_PCT=20

# Habilitar execução autônoma de ações (false = modo somente leitura)
AGENT_AUTONOMOUS_MODE=false

# -----------------------------------------------------------------------------
# EVOLUTION API — WhatsApp (aprovação humana)
# https://api.ehos.com.br
# -----------------------------------------------------------------------------
EVOLUTION_API_BASE_URL=https://api.ehos.com.br
EVOLUTION_API_KEY=                    # Global API Key da Evolution
EVOLUTION_INSTANCE_NAME=veltrus-agent # Instância ativa (connectionStatus=open)
NOTIFY_PHONE_NUMBER=                  # Destino E.164 sem + (ex: 5511999998888)
API_PUBLIC_URL=https://api.seuservidor.com  # URL pública para links de aprovação na mensagem

# Legado — n8n (descontinuado; mantido para rollback)
N8N_WEBHOOK_URL=
