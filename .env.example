# =============================================================================
# VELTRUS ADS AGENT — Variáveis de Ambiente
# Copie este arquivo para .env e preencha todos os valores
# =============================================================================

# -----------------------------------------------------------------------------
# ANTHROPIC (LLM)
# https://console.anthropic.com/
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# Modelo padrão do agente
ANTHROPIC_MODEL=claude-sonnet-4-6

# -----------------------------------------------------------------------------
# SUPABASE
# https://supabase.com/dashboard/project/<project-id>/settings/api
# -----------------------------------------------------------------------------
SUPABASE_URL=https://<project-id>.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

#-----------------------------------------------------------------------------
# META ADS (Facebook / Instagram)
# https://developers.facebook.com/apps/
# -----------------------------------------------------------------------------
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_

# Versão da API (ex: v21.0)
META_API_VERSION=v21.0

# -----------------------------------------------------------------------------
# GOOGLE ADS
# https://developers.google.com/google-ads/api/docs/first-call/overview
# -----------------------------------------------------------------------------
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=

# Login Customer ID (MCC account, se aplicável)
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Modo somente-leitura do Google Ads.
# true  = o agente analisa e registra decisões, mas NÃO executa ações na API Google
# false = o agente pode executar ações (requer também AGENT_AUTONOMOUS_MODE=true)
GOOGLE_ADS_READ_ONLY=true

# -----------------------------------------------------------------------------
# GOOGLE CLOUD / BIGQUERY ANALYTICS LAYER
# Projeto ja criado: veltrus-ads-agent
# Autenticacao recomendada: GOOGLE_APPLICATION_CREDENTIALS apontando para
# service account com BigQuery Data Editor + BigQuery Job User.
# -----------------------------------------------------------------------------
GOOGLE_CLOUD_PROJECT=veltrus-ads-agent
GCP_PROJECT_ID=veltrus-ads-agent
BIGQUERY_ENABLED=false
BIGQUERY_DATASET=veltrus_analytics
BIGQUERY_LOCATION=US
BIGQUERY_CAMPAIGN_DAILY_TABLE=campaign_daily_performance
BIGQUERY_CREDENTIALS_JSON=
GOOGLE_APPLICATION_CREDENTIALS=/secure/path/service-account.json

# -----------------------------------------------------------------------------
# FASTAPI / SERVIDOR
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=gere-uma-chave-secreta-forte-aqui
API_ALLOWED_ORIGINS=http://localhost:3000

# Ambiente: development | staging | production
ENVIRONMENT=development
DEBUG=true

# -----------------------------------------------------------------------------
# NEXT.JS DASHBOARD
# Prefixo NEXT_PUBLIC_ torna a variável acessível no browser
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://<project-id>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# -----------------------------------------------------------------------------
# AGENTE — Configurações de comportamento
# -----------------------------------------------------------------------------
# Intervalo de ciclo do agente em minutos
AGENT_CYCLE_INTERVAL_MINUTES=30

# Limite de gasto diário por conta de anúncio (USD) — proteção de segurança
AGENT_MAX_DAILY_SPEND_USD=500

# Percentual máximo de ajuste de orçamento por ciclo
AGENT_MAX_BUDGET_CHANGE_PCT=20

# Habilitar execução autônoma de ações (false = modo somente leitura)
AGENT_AUTONOMOUS_MODE=false

# Notificações humanas — n8n / WhatsApp
N8N_WEBHOOK_URL=              # URL do Webhook node no n8n (ex: https://n8n.example.com/webhook/abc123)
NOTIFY_PHONE_NUMBER=          # Número WhatsApp E.164 para receber aprovações (ex: 5511999998888)

# -----------------------------------------------------------------------------
# GOOGLE CLOUD / BIGQUERY ANALYTICS LAYER
# Projeto GCP: veltrus-ads-agent
# Setup attribution: python scripts/setup_bigquery.py
# Setup analytics mirror: bash scripts/setup_bigquery.sh
# -----------------------------------------------------------------------------
GOOGLE_CLOUD_PROJECT=veltrus-ads-agent
GCP_PROJECT_ID=veltrus-ads-agent
BIGQUERY_DATASET=veltrus_attribution
BIGQUERY_LOCATION=southamerica-east1
# Opção A: arquivo de credenciais da service account
GOOGLE_APPLICATION_CREDENTIALS=
# Opção B: JSON inline (útil em Railway/Cloud Run)
BIGQUERY_CREDENTIALS_JSON=
